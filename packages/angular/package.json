{
  "name": "@witqq/spreadsheet-angular",
  "version": "0.6.0",
  "description": "Angular wrapper for witqq Canvas spreadsheet engine",
  "keywords": [
    "spreadsheet",
    "datagrid",
    "canvas",
    "table",
    "grid",
    "excel",
    "typescript",
    "angular",
    "angular-table",
    "angular-spreadsheet"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:npm": "tsx ../../scripts/generate-npm-docs.ts --package angular",
    "prepublishOnly": "npm run build && npm run docs:npm"
  },
  "dependencies": {
    "@witqq/spreadsheet": "^0.6.0"
  },
  "peerDependencies": {
    "@angular/core": ">=17.0.0",
    "@angular/common": ">=17.0.0"
  },
  "devDependencies": {
    "@angular/compiler": "^22.1.5",
    "@angular/core": "^22.1.5",
    "@angular/common": "^22.1.5",
    "@angular/platform-browser": "^22.1.5",
    "rxjs": "^7.8.2",
    "zone.js": "^0.16.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "typescript": "~6.0.3"
  },
  "sideEffects": false,
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/witqq/spreadsheet.git",
    "directory": "packages/angular"
  },
  "homepage": "https://spreadsheet.witqq.dev/frameworks/angular",
  "bugs": {
    "url": "https://github.com/witqq/spreadsheet/issues"
  },
  "author": "witqq team <belyiwork@mail.ru>",
  "engines": {
    "node": ">=24.20.0"
  }
}
