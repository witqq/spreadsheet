{
  "name": "@witqq/spreadsheet-vue",
  "version": "0.6.0",
  "description": "Vue 3 wrapper for witqq Canvas spreadsheet engine",
  "keywords": [
    "spreadsheet",
    "datagrid",
    "canvas",
    "table",
    "grid",
    "excel",
    "typescript",
    "vue",
    "vue3",
    "vue-table",
    "vue-spreadsheet"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "docs:npm": "tsx ../../scripts/generate-npm-docs.ts --package vue",
    "prepublishOnly": "npm run build && npm run docs:npm"
  },
  "dependencies": {
    "@witqq/spreadsheet": "^0.6.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vue/compiler-dom": "^3.5.42",
    "@vue/server-renderer": "^3.5.42",
    "vue": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vue-tsc": "^3.3.11"
  },
  "sideEffects": false,
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/witqq/spreadsheet.git",
    "directory": "packages/vue"
  },
  "homepage": "https://spreadsheet.witqq.dev/frameworks/vue",
  "bugs": {
    "url": "https://github.com/witqq/spreadsheet/issues"
  },
  "author": "witqq team <belyiwork@mail.ru>",
  "engines": {
    "node": ">=24.20.0"
  }
}
